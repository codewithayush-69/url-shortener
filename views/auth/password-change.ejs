<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <!-- ZMDI Material Design Iconic Font CDN -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/material-design-iconic-font@2.2.0/dist/css/material-design-iconic-font.min.css"
    />
    <title>Change Password - URL Shortener</title>
  </head>
  <body>
    <%- include('../header') %>

    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <h1>
            <i class="zmdi zmdi-lock"></i> Change Password
          </h1>
          <p class="auth-subtext">Update your account password securely</p>
        </div>

        <% if (typeof messages.error !== 'undefined' && messages.error) { %>
        <div class="alert alert-error">
          <i class="zmdi zmdi-close-circle-o"></i>
          <span><%= messages.error[0] %></span>
        </div>
        <% } %>

        <% if (typeof messages.success !== 'undefined' && messages.success) { %>
        <div class="alert alert-success">
          <i class="zmdi zmdi-check-circle"></i>
          <span><%= messages.success[0] %></span>
        </div>
        <% } %>

        <form action="/profile/change-password" method="POST" class="auth-form">
          <div class="form-group">
            <label for="oldPassword">
              <i class="zmdi zmdi-lock-open"></i> Current Password
            </label>
            <input
              type="password"
              id="oldPassword"
              name="oldPassword"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            />
            <small class="password-hint">
              Enter your current password for verification
            </small>
          </div>

          <div class="form-group">
            <label for="password">
              <i class="zmdi zmdi-lock"></i> New Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              required
              minlength="6"
              autocomplete="new-password"
            />
            <small class="password-hint">
              Must be at least 6 characters long
            </small>
          </div>

          <div class="form-group">
            <label for="confirm_password">
              <i class="zmdi zmdi-lock-check"></i> Confirm New Password
            </label>
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              placeholder="••••••••"
              required
              minlength="6"
              autocomplete="new-password"
            />
            <small class="password-hint">
              Re-enter your new password to confirm
            </small>
          </div>

          <div class="password-requirements">
            <p>Password Requirements:</p>
            <ul>
              <li>
                <i class="zmdi zmdi-check-circle"></i> At least 6 characters
              </li>
              <li>
                <i class="zmdi zmdi-check-circle"></i> Mix of letters and
                numbers (recommended)
              </li>
              <li>
                <i class="zmdi zmdi-check-circle"></i> Different from current
                password
              </li>
            </ul>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              <i class="zmdi zmdi-refresh"></i> Update Password
            </button>
            <a href="/profile" class="btn btn-cancel">
              <i class="zmdi zmdi-close"></i> Cancel
            </a>
          </div>
        </form>

        <div class="password-info">
          <i class="zmdi zmdi-info-outline"></i>
          <p>
            For your security, make sure you use a strong password that you
            don't use on other websites.
          </p>
        </div>
      </div>
    </div>

    <%- include('../footer') %>
    
  </body>
</html>
