<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <title>Verify Email - URL Shortener</title>
</head>

<%- include('../header') %>

  <body>
    <main class="verify-email-page">
      <section class="verify-email-container">
        <div class="verify-email-card">
          <div class="verify-icon-wrapper">
            <i class="zmdi zmdi-mail-send avatar">
                <%= user.email ? user.email.charAt(0).toUpperCase() : 'U' %>
            </i>
          </div>

          <h1 class="verify-title">Verify Your Email</h1>
          <p class="verify-subtitle">We've sent a verification code to your email. Please check your inbox and enter the code below to verify your account.</p>

          <div class="verify-email-display">
            <p class="verify-label">Email Address:</p>
            <p class="verify-email-text"><%= user.email %></p>
          </div>

          <form action="/verify_email" method="POST" class="verify-email-form">
            <div class="form-group">
              <label for="verificationCode" class="form-label">Verification Code</label>
              <input
                type="text"
                id="verificationCode"
                name="verificationCode"
                placeholder="Enter 6-digit code"
                class="form-input"
                maxlength="6"
                required
              />
            </div>

            <button type="submit" class="btn btn-verify">Verify Email</button>
          </form>

          <div class="verify-footer">
            <p class="verify-footer-text">Didn't receive the code?</p>
            <form action="/resend-verification" method="POST" class="inline-form">
              <button type="submit" class="verify-resend-link">Resend Verification Code</button>
            </form>
          </div>

          <div class="verify-info">
            <p class="verify-info-text">
              <i class="zmdi zmdi-info-outline"></i>
              The verification code will expire in 24 hours. Please verify your email as soon as possible.
            </p>
          </div>
        </div>
      </section>
    </main>

    <%- include('../footer') %>
  </body>

</html>
