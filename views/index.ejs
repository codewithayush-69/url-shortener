<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <!-- ZMDI Material Design Iconic Font CDN -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/material-design-iconic-font@2.2.0/dist/css/material-design-iconic-font.min.css"
    />
    <title>URL Shortener</title>
  </head>
  <body>
    <%- include('header') %>

    <div class="main-container">
      <h1 class="page-title">URL Shortener</h1>

      <div class="form-section">
        <h2 class="section-title">Create a Short Link</h2>

        <% if (typeof messages.error !== 'undefined' && messages.error) { %>
          <div class="alert alert-error">
            <i class="zmdi zmdi-close-circle-o"></i>
            <span><%= messages.error[0] %></span>
          </div>
        <% } %>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="alert alert-success" id="successAlert">
            <i class="zmdi zmdi-check-circle"></i>
            <span>You are logged in.</span>
          </div>
          <script>
            setTimeout(() => {
              const successAlert = document.getElementById('successAlert');
              if (successAlert) {
                successAlert.style.display = 'none';
              }
            }, 30000);
          </script>
        <% } else { %>
          <div class="alert alert-info">
            <i class="zmdi zmdi-info"></i>
            <span>Please log in to manage your shortened URLs.</span>
          </div>
        <% } %>

        <form action="/" method="post" class="url-form">
          <div class="form-group">
            <label for="url" class="form-label">
              <i class="zmdi zmdi-link"></i> Enter the URL
            </label>
            <input
              type="url"
              name="url"
              id="url"
              class="form-input"
              placeholder="https://example.com/very/long/url"
              required
            />
          </div>
          <div class="form-group">
            <label for="shortCode" class="form-label">
              <i class="zmdi zmdi-code"></i> Custom Short Code 
            </label>
            <input
              type="text"
              name="shortCode"
              id="shortCode"
              class="form-input"
              placeholder="mylink"
              required
            />
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="zmdi zmdi-plus"></i> Shorten URL
          </button>
        </form>
      </div>

      <% if (links && links.length > 0) { %>
      <div class="urls-section">
        <h2 class="section-title">Your Shortened URLs</h2>
        <ul id="Shorten_url" class="url-list">
          <% links.forEach(function({id, shortCode, url}) { const truncatedURL =
          url.length > 50 ? url.slice(0, 50) + '...' : url; %>
          <li class="url-list-item">
            <div class="url-item">
              <div class="url-content">
                <div class="short-url-wrapper">
                  <a href="/<%= shortCode %>" target="_blank" class="short-link-url">
                    <%= host %>/<%= shortCode %>
                  </a>
                  <span class="url-text" title="<%= url %>"><%= truncatedURL %></span>
                </div>
              </div>
              <div class="url-actions">
                <a href="/edit/<%= id %>" class="btn btn-edit" title="Edit this link">
                  <i class="zmdi zmdi-edit"></i>
                  <span>Edit</span>
                </a>
                <form action="/delete/<%= id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this link?');">
                  <button type="submit" class="btn btn-delete" title="Delete this link">
                    <i class="zmdi zmdi-delete"></i>
                    <span>Delete</span>
                  </button>
                </form>
              </div>
            </div>
          </li>
          <% }); %>
        </ul>
      </div>
      <% } else { %>
      <div class="empty-state">
        <i class="zmdi zmdi-info"></i>
        <p>No shortened URLs yet. Create your first one above!</p>
      </div>
      <% } %>
    </div>

    <%- include('footer') %>
  </body>
</html>
